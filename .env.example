CLAUDEX_WORKHOUSE_VERSION=latest
CLAUDEX_WORKHOUSE_PORT=3410
CLAUDEX_WORKHOUSE_EXTERNAL_ORIGIN=http://127.0.0.1:3410
# Keep the default loopback binding for local setup. Before exposing through a
# reverse proxy, configure Cloudflare Access and switch this to cloudflare.
CLAUDEX_WORKHOUSE_AUTH_MODE=local
CLAUDEX_WORKHOUSE_TEAM_DOMAIN=
CLAUDEX_WORKHOUSE_AUDIENCE=
CLAUDEX_WORKHOUSE_ALLOWED_EMAIL=admin@example.invalid
# Official builds normally provide the commit in image/build metadata. Modified
# or unofficial distributions must set all three notice fields below and point
# SOURCE_URL at the Corresponding Source actually in use.
CLAUDEX_WORKHOUSE_DISTRIBUTION_STATUS=Official
CLAUDEX_WORKHOUSE_DISTRIBUTOR=
CLAUDEX_WORKHOUSE_SOURCE_URL=
CLAUDEX_WORKHOUSE_COMMIT_SHA=

# DeepSeek is a separate cloud API provider. Keep the key server-side; it is
# never stored in browser preferences or the Workhouse database.
CLAUDEX_WORKHOUSE_DEEPSEEK_API_KEY=
CLAUDEX_WORKHOUSE_DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
CLAUDEX_WORKHOUSE_DEEPSEEK_DEFAULT_MODEL=deepseek-v4-pro

# Ollama Cloud is a separate remote provider. Create an API key on ollama.com;
# models are discovered from the authenticated /api/tags endpoint.
CLAUDEX_WORKHOUSE_OLLAMA_BASE_URL=https://ollama.com
CLAUDEX_WORKHOUSE_OLLAMA_API_KEY=
CLAUDEX_WORKHOUSE_OLLAMA_DEFAULT_MODEL=

# Google Antigravity CLI provider. Install and sign in with `agy` on the
# Workhouse host first; model choices are read from `agy models`.
CLAUDEX_WORKHOUSE_ANTIGRAVITY_BINARY=agy
CLAUDEX_WORKHOUSE_ANTIGRAVITY_DEFAULT_MODEL=
