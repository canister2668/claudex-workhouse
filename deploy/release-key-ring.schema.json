{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claudex-workhouse.invalid/schemas/release-key-ring.schema.json",
  "title": "Claudex Workhouse embedded public release key ring",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "keys"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyId",
          "algorithm",
          "publicKeyPem",
          "notBefore",
          "expiresAt",
          "revoked"
        ],
        "properties": {
          "keyId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
          },
          "algorithm": { "const": "rsa-sha256" },
          "publicKeyPem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "description": "RSA SubjectPublicKeyInfo PEM. Production private keys are never part of this document."
          },
          "notBefore": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "revoked": { "type": "boolean" }
        }
      }
    }
  }
}
